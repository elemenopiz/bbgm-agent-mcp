{
  "name": "bbgm-agent-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP research environment for long-horizon agent planning in Basketball GM",
  "type": "module",
  "bin": {
    "bbgm-agent-mcp": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "dev": "tsx src/cli.ts",
    "engine:build": "node scripts/build-engine-bridge.ts",
    "engine:verify": "node scripts/verify-engine.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "seedrandom": "^3.0.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/seedrandom": "^3.0.8",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
